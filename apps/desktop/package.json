  },
  "dependencies": {
    "@notalocal/types": "workspace:*",
    "@notalocal/ui": "workspace:*",
    "@qvac/sdk": "0.17.1",
    "bare-runtime-win32-x64": "1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "38.8.6",
    "electron-vite": "^4.0.0",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
