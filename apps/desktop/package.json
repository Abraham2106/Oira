{
  "name": "oira-desktop",
  "private": true,
  "version": "0.1.0",
  "productName": "Oira",
  "description": "Local-first desktop assistant for clinician-reviewed consultation notes.",
  "author": "Oira contributors",
  "type": "module",
  "main": "./dist/main/index.js",
  "files": ["dist", "qvac"],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-forge package --platform=win32 --arch=x64",
    "make": "node scripts/prepare-squirrel.mjs && electron-vite build && electron-forge make --platform=win32 --arch=x64",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:packaging": "node scripts/verify-packaged-runtime.cjs",
    "lint": "eslint src/renderer src/main --max-warnings=0",
    "runtime:versions": "node scripts/print-runtime.mjs",
    "qvac:smoke": "node scripts/qvac-smoke.mjs",
    "qvac:whisper": "node scripts/qvac-whisper.mjs",
    "qvac:qwen": "node scripts/qvac-qwen.mjs",
    "qvac:record": "electron scripts/qvac-record.mjs",
    "eval": "node --experimental-strip-types --experimental-transform-types --import ../../eval/register-ts.mjs --disable-warning=ExperimentalWarning ../../eval/runner.mjs"
  },
  "dependencies": {
    "@oira/types": "workspace:*",
    "@oira/ui": "workspace:*",
    "@qvac/sdk": "0.18.2",
    "bare-runtime-win32-x64": "1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/plugin-base": "7.11.1",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "38.8.6",
    "electron-vite": "^4.0.0",
    "electron-winstaller": "5.4.4",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
