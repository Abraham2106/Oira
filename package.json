{
  "name": "oira",
  "private": true,
  "scripts": {
    "atlas:check": "node scripts/architecture/atlas/check.mjs",
    "atlas:capture": "node scripts/architecture/atlas/capture.mjs",
    "dev": "pnpm install && pnpm dev:desktop",
    "dev:desktop": "pnpm --filter oira-desktop dev",
    "test": "pnpm --filter oira-desktop test",
    "lint:desktop": "pnpm --filter oira-desktop lint",
    "typecheck": "pnpm --filter @oira/types typecheck && pnpm --filter oira-desktop typecheck",
    "eval:fixtures": "node eval/fixtures/_write.mjs",
    "eval:self-check": "node --test eval/scorer.test.mjs eval/fixtures.test.mjs",
    "eval": "node --experimental-strip-types --experimental-transform-types --import ./eval/register-ts.mjs --disable-warning=ExperimentalWarning eval/runner.mjs"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.17"
  }
}
