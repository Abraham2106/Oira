{
  "name": "notalocal",
  "private": true,
  "scripts": {
    "dev:desktop": "pnpm --filter notalocal-desktop dev",
    "eval": "pnpm --filter notalocal-desktop eval",
    "test": "pnpm --filter notalocal-desktop test",
    "lint:desktop": "pnpm --filter notalocal-desktop lint",
    "typecheck": "pnpm --filter @notalocal/types typecheck && pnpm --filter notalocal-desktop typecheck"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "@qvac/sdk"],
    "packageExtensions": {
      "bare-runtime-win32-x64": {
        "dependencies": {
          "require-asset": "^1.0.2"
        }
      }
    }
  }
}
