{
  "name": "oira",
  "private": true,
  "scripts": {
    "dev": "pnpm install && pnpm dev:desktop",
    "dev:desktop": "pnpm --filter oira-desktop dev",
    "test": "pnpm --filter oira-desktop test",
    "lint:desktop": "pnpm --filter oira-desktop lint",
    "typecheck": "pnpm --filter @oira/types typecheck && pnpm --filter oira-desktop typecheck"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.17"
  }
}
